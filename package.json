{
  "name": "browserail",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "build": "pnpm clean:build && pnpm --filter @browserail/protocol build && pnpm --filter @browserail/extension build && pnpm build:windows",
    "build:extension": "pnpm --filter @browserail/extension... -r build",
    "build:release": "node scripts/build-release.mjs",
    "build:windows": "pnpm --filter @browserail/desktop build && node scripts/build-desktop-windows.mjs",
    "check": "pnpm -r check",
    "clean:build": "node scripts/clean-build.mjs",
    "lint": "pnpm lint:code && pnpm lint:firefox",
    "lint:code": "eslint .",
    "lint:firefox": "pnpm build:extension && web-ext lint --source-dir build/extension/firefox",
    "test": "pnpm -r test && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "tauri": "pnpm --filter @browserail/desktop tauri"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "globals": "^17.13.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "web-ext": "^10.7.0"
  }
}
