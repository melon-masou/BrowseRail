{
  "manifest_version": 3,
  "name": "BrowseRail",
  "version": "0.1.0",
  "description": "External bookmark controls for browser windows.",
  "permissions": ["bookmarks", "storage"],
  "background": {
    "scripts": ["background.js"]
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "BrowseRail settings",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "browserail@local",
      "data_collection_permissions": {
        "required": ["bookmarksInfo"]
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src ws://127.0.0.1:* ws://localhost:* http://127.0.0.1:* http://localhost:*"
  }
}
